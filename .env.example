# LiveKit Cloud project credentials (used by the agent worker and the token server).
# Get these from your project settings at https://cloud.livekit.io
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Local / self-hosted LLM. Point this at any OpenAI-compatible chat completions
# server (Ollama, vLLM, LM Studio, your company's own LLM gateway, etc).
# LOCAL_LLM_URL should be the base URL the OpenAI client should call, e.g.
# http://localhost:11434/v1 for Ollama, or http://localhost:8000/v1 for vLLM.
LOCAL_LLM_URL=http://localhost:8000/v1
LOCAL_LLM_MODEL=
# Only needed if your local server requires a bearer token; most don't.
LOCAL_LLM_API_KEY=
# Alternative to running something locally: point LOCAL_LLM_URL at
# https://openrouter.ai/api/v1 and set this instead of LOCAL_LLM_API_KEY —
# src/llm/localLlm.ts recognizes it directly.
OPENROUTER_API_KEY=

# Port for the local token-minting server (src/tokenServer.ts) used by the frontend.
TOKEN_SERVER_PORT=8080
