{
  "name": "agent-starter-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,js}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev": "node src/main.ts dev",
    "start": "node src/main.ts start",
    "token-server": "node src/tokenServer.ts",
    "demo": "concurrently -n token-server,agent,frontend -c blue,green,magenta \"pnpm run token-server\" \"pnpm run dev\" \"pnpm --filter frontend dev\""
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.10.1",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.4",
    "globals": "^16.5.0",
    "jiti": "^2.6.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.1",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "@livekit/agents": "^1.6.3",
    "@livekit/plugins-ai-coustics": "^0.2.14",
    "@livekit/rtc-node": "^0.13.31",
    "dotenv": "^17.4.1",
    "livekit-server-sdk": "^2.14.1",
    "openai": "^6.8.1",
    "pdf-parse": "^1.1.1",
    "zod": "^4.4.3"
  }
}
