# Base URL of the standalone token server (src/tokenServer.ts, run via `pnpm run token-server`
# from the repo root) — only needed for local development.
#
# Leave this UNSET when deploying to Vercel: with no value, the frontend calls its own
# same-origin serverless function at api/connection-details.ts instead, which Vercel deploys
# alongside it. Set LIVEKIT_URL / LIVEKIT_API_KEY / LIVEKIT_API_SECRET as Vercel Environment
# Variables (not this one) for that function to work.
VITE_TOKEN_SERVER_URL=http://localhost:8080
